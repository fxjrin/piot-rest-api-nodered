    "id": "query_history",
    "type": "function",
    "z": "flow_api",
    "name": "Parameter Limit",
    "func": "const limit = Math.min(Math.max(parseInt(msg.req.query.limit, 10) || 50, 1), 500);\nmsg.params = { $limit: limit };\nreturn msg;",
    "outputs": 1,
    "x": 600,
