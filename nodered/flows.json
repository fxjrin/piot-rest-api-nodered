  {
    "id": "c_sensor",
    "type": "comment",
    "z": "flow_api",
    "name": "Data sensor dari ESP32 (MQTT) -> SQLite, WebSocket, notifikasi",
    "info": "",
    "x": 350,
    "y": 140,
    "wires": []
  },
  {
    "id": "mqtt_sensor_in",
    "type": "mqtt in",
    "z": "flow_api",
    "name": "Subscribe Sensor",
    "topic": "",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_config",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 1,
    "x": 240,
    "y": 200,
    "wires": [
      [
        "store_sensor"
      ]
    ]
  },
  {
    "id": "store_sensor",
    "type": "function",
    "z": "flow_api",
    "name": "Proses Data Sensor",
    "func": "const data = msg.payload;\nif (typeof data.suhu !== \"number\" || typeof data.kelembaban !== \"number\") {\n  node.warn(\"Data sensor diabaikan, suhu/kelembaban bukan angka\");\n  return null;\n}\ndata.received = new Date().toISOString();\nflow.set(\"lastSensor\", data);\n\nconst simpan = {\n  params: { $suhu: data.suhu, $kelembaban: data.kelembaban, $timestamp: data.timestamp || null, $received: data.received }\n};\nconst live = { payload: { type: \"sensor\", data } };\n\n// Notifikasi hanya saat suhu baru melewati batas, bukan di setiap data selama masih di atas batas\nconst batas = flow.get(\"threshold\") ?? 30;\nconst diAtas = data.suhu > batas;\nlet notif = null;\nif (diAtas && !flow.get(\"diAtasBatas\")) {\n  notif = {\n    payload: {\n      type: \"alert\",\n      suhu: data.suhu,\n      batas,\n      pesan: \"Suhu \" + data.suhu + \" C melewati batas \" + batas + \" C\",\n      waktu: data.received\n    }\n  };\n}\nflow.set(\"diAtasBatas\", diAtas);\n\nreturn [simpan, live, notif];",
    "outputs": 3,
    "x": 480,
    "y": 200,
    "wires": [
      [
        "sqlite_insert"
      ],
      [
        "ws_out",
        "debug_sensor"
      ],
      [
        "mqtt_notif",
        "ws_out",
        "debug_notif"
      ]
    ]
  },
  {
    "id": "sqlite_insert",
    "type": "sqlite",
    "z": "flow_api",
    "mydb": "db_config",
    "sqlquery": "prepared",
    "sql": "INSERT INTO sensor (suhu, kelembaban, timestamp, received) VALUES ($suhu, $kelembaban, $timestamp, $received)",
    "name": "Simpan ke SQLite",
    "x": 740,
    "y": 160,
