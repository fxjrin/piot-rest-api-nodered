  {
    "id": "proc_kontrol",
    "type": "function",
    "z": "flow_api",
    "name": "Validasi & Publish",
    "func": "const body = msg.payload || {};\nif (!body.device || !body.action) {\n  msg.statusCode = 400;\n  msg.payload = { status: \"error\", message: \"device dan action wajib diisi\" };\n  return [msg, null];\n}\n\nconst perintah = { topic: \"iot/kontrol\", payload: { device: body.device, action: body.action } };\nmsg.payload = { status: \"success\", message: \"Perintah terkirim\", sent: perintah.payload };\nreturn [msg, perintah];",
    "outputs": 2,
    "x": 620,
    "y": 640,
    "wires": [
      [
        "http_resp_kontrol"
      ],
      [
        "mqtt_publish_kontrol"
      ]
    ]
  },
