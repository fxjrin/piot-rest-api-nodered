  {
    "id": "sf_auth",
    "type": "subflow",
    "name": "Cek API Key",
    "info": "Meloloskan request jika header X-API-Key sama dengan env API_KEY. Jika tidak, keluar lewat output 2 dengan status 401.",
    "category": "",
    "color": "#E2D96E",
    "icon": "font-awesome/fa-key",
    "in": [
      {
        "x": 60,
        "y": 80,
        "wires": [
          {
            "id": "sf_auth_fn"
          }
        ]
      }
    ],
    "out": [
      {
        "x": 360,
        "y": 60,
        "wires": [
          {
            "id": "sf_auth_fn",
            "port": 0
          }
        ]
      },
      {
        "x": 360,
        "y": 100,
        "wires": [
          {
            "id": "sf_auth_fn",
            "port": 1
          }
        ]
      }
    ],
    "env": [],
    "inputLabels": [
      "request"
    ],
    "outputLabels": [
      "lolos",
      "ditolak 401"
    ]
  },
  {
    "id": "sf_auth_fn",
    "type": "function",
    "z": "sf_auth",
    "name": "Cocokkan X-API-Key",
    "outputs": 2,
    "x": 210,
    "y": 80,
    "wires": [
      [],
      []
    ],
    "func": "\nconst kunci = env.get(\"API_KEY\") || \"iot-2410020079\";\nif (msg.req.headers[\"x-api-key\"] === kunci) return [msg, null];\n\nmsg.statusCode = 401;\nmsg.payload = { status: \"error\", message: \"API key salah atau tidak ada (header X-API-Key)\" };\nreturn [null, msg];"
  },
