    "id": "sqlite_history",
    "type": "sqlite",
    "z": "flow_api",
    "mydb": "db_config",
    "sqlquery": "prepared",
    "sql": "SELECT suhu, kelembaban, timestamp, received FROM (SELECT * FROM sensor ORDER BY id DESC LIMIT $limit) ORDER BY id ASC",
