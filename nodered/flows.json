  {
    "id": "proc_threshold",
    "type": "function",
    "z": "flow_api",
    "name": "Set Batas Suhu",
    "func": "const batas = (msg.payload || {}).batas;\n// Rentang ukur DHT22\nif (typeof batas !== \"number\" || batas < -40 || batas > 80) {\n  msg.statusCode = 400;\n  msg.payload = { status: \"error\", message: \"batas wajib angka antara -40 dan 80\" };\n  return [msg, null];\n}\n\nflow.set(\"threshold\", batas);\nflow.set(\"diAtasBatas\", false); // agar suhu yang sudah di atas batas baru tetap memicu notifikasi\nmsg.payload = { status: \"success\", message: \"Batas suhu disimpan\", batas };\nreturn [msg, { payload: { type: \"threshold\", batas } }];",
    "outputs": 2,
    "x": 640,
    "y": 760,
    "wires": [
      [
        "http_resp_put_threshold"
      ],
      [
        "ws_out"
      ]
    ]
